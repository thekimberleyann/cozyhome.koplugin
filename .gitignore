# ── SQLite databases (created at runtime on device) ──
data/*.db
data/*.db-wal
data/*.db-shm
*.db
*.db-wal
*.db-shm

# ── OS junk ──
.DS_Store
Thumbs.db
Desktop.ini
ehthumbs.db

# ── Editor / IDE files ──
*.swp
*.swo
*~
.vscode/
.idea/
*.sublime-project
*.sublime-workspace

# ── Lua bytecode ──
*.luac
luac.out

# ── KOReader runtime files (generated on device) ──
crash.log
settings.reader.lua
*.sdr/

# ── Debug / test logs ──
*.log

# ── Luacheck / Luacov artifacts ──
.luacheckcache
luacov.stats.out
luacov.report.out

# ── Release archives ──
*.zip
